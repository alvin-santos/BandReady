# Copy to `.env` or `.env.local` and restart `npm run dev`.
# Backend Laravel API (must include /api path — or use host only; client appends /api).
#
# Direct to Laravel (recommended if you see requests stuck on localhost:5174):
VITE_API_URL=http://127.0.0.1:8080
#
# Or leave unset to use same-origin `/api` and Vite proxy (vite.config.js → target).
#
# Public site URL (no trailing slash) — used for canonical URLs, Open Graph, and Twitter meta in production.
# Leave unset in dev to use the browser origin (e.g. http://localhost:5173).
# VITE_SITE_URL=https://your-production-domain.com
