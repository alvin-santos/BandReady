APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Public URL of this Laravel app (API). Used for Google OAuth callback default, sitemap, etc.
# Production split domain: https://api.band-ready.com
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=bandready
# DB_USERNAME=postgres
# DB_PASSWORD=

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# SPA (Vite/React) base URL — email verification + Google OAuth send users here after the API handles the request.
# Production: https://band-ready.com (no trailing slash). This is NOT the same as APP_URL when API is on a subdomain.
FRONTEND_URL=http://localhost:5173

# Stripe — one-time Pro checkout (create a one-time Price in Stripe Dashboard)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional: months granted per purchase (default 12)
# SUBSCRIPTION_PRO_MONTHS=12
# Local/dev only: allow POST /subscription/simulate-checkout without Stripe (disable in production)
SUBSCRIPTION_SIMULATE_ENABLED=false

# Google Sign-In (OAuth). Authorized redirect URI in Google Cloud Console must be exactly:
#   {APP_URL}/auth/google/callback   e.g. https://api.band-ready.com/auth/google/callback
# Start URL (from the app): {APP_URL}/oauth/google  (legacy: /auth/google on the API still works)
# After Google returns to /auth/google/callback, Laravel redirects the browser to FRONTEND_URL/auth/google#token=...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# When true, /auth/google/callback returns an HTML debug page instead of redirecting (disable after troubleshooting).
GOOGLE_OAUTH_DEBUG=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional default for `php artisan bandready:test-email` (no argument)
MAIL_TEST_ADDRESS=

# Progress reminder emails (needs system cron: * * * * * php artisan schedule:run)
BANDREADY_PROGRESS_REMINDER_ENABLED=true
BANDREADY_REMINDER_INTERVAL_DAYS=7
BANDREADY_REMINDER_ACTIVITY_DAYS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI (optional): used by `php artisan openai:generate-questionnaire` (add `--with-speaking-images` for CELPIP-style picture speaking + DALL·E after import)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=180
# OPENAI_MAX_COMPLETION_TOKENS=16384
# Essay grading (defaults to OPENAI_MODEL if unset)
# OPENAI_WRITING_MODEL=gpt-4o-mini
# OPENAI_WRITING_TIMEOUT=90
# ESSAY_MAX_CHARS=4000
# Speaking: Whisper STT + transcript feedback (optional overrides)
# OPENAI_WHISPER_MODEL=whisper-1
# OPENAI_WHISPER_TIMEOUT=120
# SPEAKING_MAX_CHARS=4000
# SPEAKING_MAX_RECORD_SECONDS=180
# OPENAI_SPEAKING_MODEL=gpt-4o-mini
# OPENAI_SPEAKING_TIMEOUT=90
# Speaking scene images (DALL·E 3; admin “Generate image” on speaking questions)
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_TIMEOUT=120
# Log OpenAI request/response JSON to openai_activity_logs (true/false)
# OPENAI_LOG_ACTIVITY=true

# Exam access: guests may only start these sections (comma-separated, case-insensitive). Default: Reading,Writing
# EXAM_ACCESS_GUEST_SECTIONS=Reading,Writing
# Free (signed-in, non-Pro) users: max Speaking tests started (total count). Pro/admin unlimited. Default: 3. Use 0 to require Pro for Speaking.
# EXAM_ACCESS_FREE_SPEAKING_LIMIT=3
# Optional override for the notice shown when Speaking is disabled after policy detection (see config/exam_access.php).
# EXAM_ACCESS_SPEAKING_AI_SUSPENSION_NOTICE=
